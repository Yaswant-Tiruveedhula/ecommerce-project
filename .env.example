# Frontend API base URL. For local development, Vite proxies /api to the backend.
VITE_API_BASE_URL=/api/v1
VITE_STORE_CURRENCY=USD

# Backend and database variables.
PORT=8080
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ecommerce
DB_USERNAME=ecommerce_app
DB_PASSWORD=change-me
DB_SSL_MODE=DISABLED
FRONTEND_URL=http://localhost:5173
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
APP_COOKIE_SECURE=false
APP_COOKIE_SAME_SITE=Lax
STORE_CURRENCY=USD
SEED_DEMO_DATA=false
# Set both once during first admin provisioning. Use a new, unused email.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
